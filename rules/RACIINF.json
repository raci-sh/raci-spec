{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIINF",
    "title": "RACI inference",
    "description": "Triggered inference rules, ESIS style: shape, actions, non-recursion, evaluation order and composition of deltas (SPEC.md section 3.1)."
  },
  "rule_set": {
    "version": "0.1.80",
    "timestamp": "2026-11-25T16:08:53Z",
    "hash": "blake3:80237b663955677be6ca7ee161a41175b5f304414cab4d8238ebc4b630a70633"
  },
  "rules": [
    {
      "id": "RACIINF-001",
      "revision": 0,
      "state": "D",
      "body": "An inference rule MUST consist of a target type, an operation, an optional trigger type, an optional selector and a list of actions.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-002",
      "revision": 1,
      "state": "D",
      "body": "The only resource operation of an inference rule MUST be new.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-003",
      "revision": 0,
      "state": "D",
      "body": "The inference action vocabulary MUST be map, add-issuer and strip.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-004",
      "revision": 0,
      "state": "D",
      "body": "The map action MUST give the parties holding the from-role on the source the to-role on the target.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-005",
      "revision": 0,
      "state": "D",
      "body": "The add-issuer action MUST give the party creating the target the named role.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-006",
      "revision": 0,
      "state": "D",
      "body": "The strip action MUST remove a role on the target from the parties holding a named role on the source of the action's source type.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-007",
      "revision": 0,
      "state": "D",
      "body": "An action carrying the add-only attribute MUST add missing entries only, leaving existing entries unchanged.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-008",
      "revision": 0,
      "state": "D",
      "body": "The map and strip actions MUST locate their source as the nearest resource of the action's source type, searching the target itself and then its parent links, unless the rule names a selector.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-009",
      "revision": 0,
      "state": "D",
      "body": "When no rule matches a new target and min-ra is enabled, the originating change MUST be rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-010",
      "revision": 0,
      "state": "D",
      "body": "When no rule matches a new target and min-ra is not enabled, the target MUST be created with an empty RACI and a no-matching-rule finding recorded in the commit marker.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-011",
      "revision": 0,
      "state": "D",
      "body": "Inferred changes MUST pass through the enabled constraints like any other change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-012",
      "revision": 0,
      "state": "D",
      "body": "Inferred changes MUST be audited with the rule that produced them.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-013",
      "revision": 0,
      "state": "D",
      "body": "Inference MUST be non-recursive, so that only the original change is evaluated against the rule set, once.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-014",
      "revision": 0,
      "state": "D",
      "body": "All inference rules MUST see the same input: the original change and the state before any inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-015",
      "revision": 0,
      "state": "D",
      "body": "A derivation across several levels MUST be expressed as a direct rule on the final target, triggered by the original change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-016",
      "revision": 0,
      "state": "D",
      "body": "Inference rules MUST be evaluated in rule-id order, with ties broken by realm depth and then by name.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-017",
      "revision": 0,
      "state": "D",
      "body": "Each inference action MUST produce deltas, role additions or removals, composed per party, activity, resource and role on top of the state before inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-018",
      "revision": 0,
      "state": "D",
      "body": "When one delta adds and another removes the same role for the same party, activity and resource, the stricter outcome MUST win, with ties going to the earlier rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-019",
      "revision": 0,
      "state": "D",
      "body": "The stricter outcome MUST be the one whose resulting state satisfies more enabled constraints.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-020",
      "revision": 0,
      "state": "D",
      "body": "The losing delta MUST be discarded and recorded in the audit log with both rule ids.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-021",
      "revision": 0,
      "state": "D",
      "body": "If the composed result violates an enabled constraint, the whole change MUST be rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-022",
      "revision": 0,
      "state": "D",
      "body": "The result of a strip action MUST satisfy every enabled constraint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-023",
      "revision": 0,
      "state": "D",
      "body": "The operations add, update and remove MUST denote entry events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-024",
      "revision": 0,
      "state": "D",
      "body": "A rule with a trigger type MUST have the operation add, update or remove, and fires on entry events of that type with that operation, for each target whose source binds to the changed resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-025",
      "revision": 0,
      "state": "D",
      "body": "The add-issuer action MUST be used only in rules whose operation is new.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-026",
      "revision": 0,
      "state": "D",
      "body": "The target type of an inference rule MAY be the wildcard *, which matches a resource of any type.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIINF-027",
      "revision": 0,
      "state": "D",
      "body": "The wildcard * MUST NOT be used as the source type of an action or as the trigger type of a rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIINF-028",
      "revision": 0,
      "state": "D",
      "body": "An inference action MAY name an activity.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIINF-029",
      "revision": 0,
      "state": "D",
      "body": "An inference action that names no activity MUST apply to every activity on the target.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIINF-030",
      "revision": 0,
      "state": "D",
      "body": "A selector MUST name exactly one source resource by realm and id, whose realm is the realm in whose log the rule is in force or an ancestor of that realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-031",
      "revision": 0,
      "state": "D",
      "body": "A selector MUST be given only on a rule that has a map or strip action.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-032",
      "revision": 0,
      "state": "D",
      "body": "Every map and strip action of a rule with a selector MUST use the selected resource as its source.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-033",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be rejected with invalid-change when it fires a rule whose selected resource does not exist or is not of the source type of the action.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-034",
      "revision": 0,
      "state": "D",
      "body": "The removals of a delete MUST NOT fire inference rules.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-035",
      "revision": 0,
      "state": "D",
      "body": "An inference action MUST NOT produce a delta on a resource that the change deletes.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIINF-036",
      "revision": 0,
      "state": "D",
      "body": "A rule fired by an entry event MUST apply its map and strip actions only to the party of that event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACIINF-037",
      "revision": 0,
      "state": "D",
      "body": "A strip action fired by a remove MUST read the roles that the party held on the source before the change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACIINF-038",
      "revision": 0,
      "state": "D",
      "body": "A replace event MUST fire inference rules as the add, update or remove that its roles before and after amount to.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    }
  ],
