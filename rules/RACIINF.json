{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIINF",
    "title": "RACI inference",
    "description": "Triggered inference rules, ESIS style: shape, actions, non-recursion, evaluation order and composition of deltas (SPEC.md section 3.1)."
  },
  "rule_set": {
    "version": "0.1.47",
    "timestamp": "2026-11-07T08:35:19Z",
    "hash": "blake3:851983f48c6d0a0dfd97d475a29266109456a8d47efd0e3038da59274728b8e8"
  },
  "rules": [
    {
      "id": "RACIINF-001",
      "revision": 0,
      "state": "D",
      "body": "An inference rule MUST consist of a target type, an operation, an optional trigger type and a list of actions.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-002",
      "revision": 1,
      "state": "D",
      "body": "The operations new and delete MUST denote resource events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-003",
      "revision": 0,
      "state": "D",
      "body": "The inference action vocabulary MUST be map, add-issuer and strip.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-004",
      "revision": 0,
      "state": "D",
      "body": "The map action MUST give the parties holding the from-role on the source the to-role on the target.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-005",
      "revision": 0,
      "state": "D",
      "body": "The add-issuer action MUST give the party creating the target the named role.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-006",
      "revision": 0,
      "state": "D",
      "body": "The strip action MUST remove a role on the target from the parties holding a named role on the source.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-007",
      "revision": 0,
      "state": "D",
      "body": "An action carrying the add-only attribute MUST add missing entries only, leaving existing entries unchanged.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-008",
      "revision": 0,
      "state": "D",
      "body": "The map and strip actions MUST locate the source by following the target's parent links to the nearest ancestor of the trigger type, unless the rule names a selector.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-009",
      "revision": 0,
      "state": "D",
      "body": "When no rule matches a new target and min-ra is enabled, the originating change MUST be rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-010",
      "revision": 0,
      "state": "D",
      "body": "When no rule matches a new target and min-ra is not enabled, the target MUST be created with an empty RACI and a no-matching-rule finding recorded in the commit marker.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-011",
      "revision": 0,
      "state": "D",
      "body": "Inferred changes MUST pass through the enabled constraints like any other change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-012",
      "revision": 0,
      "state": "D",
      "body": "Inferred changes MUST be audited with the rule that produced them.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-013",
      "revision": 0,
      "state": "D",
      "body": "Inference MUST be non-recursive, so that only the original change is evaluated against the rule set, once.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-014",
      "revision": 0,
      "state": "D",
      "body": "All inference rules MUST see the same input: the original change and the state before any inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-015",
      "revision": 0,
      "state": "D",
      "body": "A derivation across several levels MUST be expressed as a direct rule on the final target, triggered by the original change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-016",
      "revision": 0,
      "state": "D",
      "body": "Inference rules MUST be evaluated in rule-id order, with ties broken by realm depth and then by name.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-017",
      "revision": 0,
      "state": "D",
      "body": "Each inference action MUST produce deltas, role additions or removals, composed per party, resource and role on top of the state before inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-018",
      "revision": 0,
      "state": "D",
      "body": "When one delta adds and another removes the same role for the same party and resource, the stricter outcome MUST win, with ties going to the earlier rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-019",
      "revision": 0,
      "state": "D",
      "body": "The stricter outcome MUST be the one whose resulting state satisfies more enabled constraints.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-020",
      "revision": 0,
      "state": "D",
      "body": "The losing delta MUST be discarded and recorded in the audit log with both rule ids.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-021",
      "revision": 0,
      "state": "D",
      "body": "If the composed result violates an enabled constraint, the whole change MUST be rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-022",
      "revision": 0,
      "state": "D",
      "body": "The result of a strip action MUST satisfy every enabled constraint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINF-023",
      "revision": 0,
      "state": "D",
      "body": "The operations add, update and remove MUST denote entry events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    }
  ],
  "notes": [
