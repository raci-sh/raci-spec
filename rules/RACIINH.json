{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIINH",
    "title": "RACI inheritance",
    "description": "Tighten-only inheritance of constraint policy, the override lint, and entry resolution across realm levels (SPEC.md section 3)."
  },
  "rule_set": {
    "version": "0.1.23",
    "timestamp": "2026-11-25T06:52:57Z",
    "hash": "blake3:844eac78b48143b76d85b60ca53287d8b72753ea7189a05ea7011d1888fd5a83"
  },
  "rules": [
    {
      "id": "RACIINH-001",
      "revision": 0,
      "state": "D",
      "body": "A sub-realm MUST NOT relax or disable a constraint set by an ancestor realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-002",
      "revision": 0,
      "state": "D",
      "body": "The effective constraint policy of a realm MUST be the union of the constraints along its realm path.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-003",
      "revision": 0,
      "state": "D",
      "body": "A sub-realm MUST NOT remove a separation-of-duties conflict pair inherited from an ancestor realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-004",
      "revision": 0,
      "state": "D",
      "body": "The realm tree MUST decide which entries and which constraint policy apply to a change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-005",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh rules MUST inherit through the inherits chain of their entities.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-006",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh MUST lint every override of a constraint rule and reject an override whose effect is weaker than the rule it replaces.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-007",
      "revision": 0,
      "state": "D",
      "body": "A constraint override MUST count as not weaker only if its enabled constraints and conflict pairs are a superset of those of the overridden rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-008",
      "revision": 0,
      "state": "D",
      "body": "An override that the lint cannot prove not weaker MUST be rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-009",
      "revision": 0,
      "state": "D",
      "body": "The override lint MUST NOT compare inference rules for strength, since they set entries and not policy.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-010",
      "revision": 1,
      "state": "D",
      "body": "The grants of a realm MUST be the union of the grants that the realm and its ancestors record, with no override.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIINH-011",
      "revision": 0,
      "state": "D",
      "body": "A change MUST NOT update, remove or replace an entry that another realm recorded.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACIINH-012",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be rejected with invalid-change when a role that its inference strips is still granted by an ancestor realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    }
  ],
