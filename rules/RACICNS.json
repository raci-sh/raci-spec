{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACICNS",
    "title": "RACI constraints",
    "description": "The named constraints that express strictness, and how a violating change is handled (SPEC.md section 2)."
  },
  "rule_set": {
    "version": "0.1.65",
    "timestamp": "2026-11-22T14:57:37Z",
    "hash": "blake3:9fb7710b355755e198daed52949fa9ac0e956d5ace6e8a2978e6046552320d62"
  },
  "rules": [
    {
      "id": "RACICNS-001",
      "revision": 0,
      "state": "D",
      "body": "Strictness MUST be expressed as a set of named constraints, each switchable per realm: single-accountable, single-responsible, one-role-per-party, min-ra and separation-of-duties.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-002",
      "revision": 0,
      "state": "D",
      "body": "When single-accountable is enabled, there MUST be at most one A per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-003",
      "revision": 0,
      "state": "D",
      "body": "When single-responsible is enabled, there MUST be at most one R per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-004",
      "revision": 0,
      "state": "D",
      "body": "When one-role-per-party is enabled, a party MUST hold at most one role per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-005",
      "revision": 1,
      "state": "D",
      "body": "When min-ra is enabled, at least one R or A MUST remain per activity and resource, so removing the last one needs a named substitute.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-006",
      "revision": 2,
      "state": "D",
      "body": "When a conflict pair is in effect, a party that holds any role of one side MUST NOT hold another grant with any role of the other side on resources that stand in the relation of the pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-007",
      "revision": 1,
      "state": "D",
      "body": "A change that violates an enabled constraint MUST be rejected, with no silent demotion or alteration of roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-008",
      "revision": 1,
      "state": "D",
      "body": "Constraint evaluation MUST be deterministic and performed by the raci CLI.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-009",
      "revision": 3,
      "state": "D",
      "body": "A change to a parent entry, a resource created or deleted, a change of the effective conflict pairs, or a new or tightened constraint MUST also revalidate, read-only, the descendant realms of the same realm tree that its effective entries, resources or pairs reach.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-010",
      "revision": 1,
      "state": "D",
      "body": "Realms outside the realm tree of a change MUST NOT be revalidated by it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-011",
      "revision": 0,
      "state": "D",
      "body": "Conflict pairs MUST be evaluated among the entries of the declaring realm and its descendants, and never between sibling or unrelated realms.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-012",
      "revision": 0,
      "state": "D",
      "body": "An explicit, logged replace action MAY transfer a role within one audited change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-013",
      "revision": 0,
      "state": "D",
      "body": "An LLM-based review of a change MUST be advisory only.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-014",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be rejected, naming the descendant realm and the constraint, if revalidation leaves any descendant realm in violation.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-015",
      "revision": 0,
      "state": "D",
      "body": "Violations in realms outside the realm tree of a change MUST be reported as findings when those realms next load.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-016",
      "revision": 0,
      "state": "D",
      "body": "A conflict pair MUST have a relation of same, lineage or any and two sides, each with an activity, a resource selector and a set of roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-017",
      "revision": 0,
      "state": "D",
      "body": "A side of a conflict pair MUST match a grant of an activity, resource and role when the activity and resource are selected and the role is any one of its roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-018",
      "revision": 0,
      "state": "D",
      "body": "The relation same MUST hold only for one and the same resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-019",
      "revision": 0,
      "state": "D",
      "body": "The relation lineage MUST hold only for one and the same resource or for two resources of which one is an ancestor of the other through parent links.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-020",
      "revision": 0,
      "state": "D",
      "body": "The relation any MUST hold for any two resources in the scope of the pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-021",
      "revision": 0,
      "state": "D",
      "body": "A single grant MUST NOT conflict with itself.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-022",
      "revision": 0,
      "state": "D",
      "body": "The two sides of a conflict pair MUST be evaluated as unordered, so that a pair and its mirror are the same pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-023",
      "revision": 0,
      "state": "D",
      "body": "The effective conflict pairs of a realm MUST be those of the applied add-pair events and of the conflict-pair rules in force in that realm and its ancestors.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-024",
      "revision": 0,
      "state": "D",
      "body": "Separation of duties MUST be in effect whenever the effective conflict pairs are not empty, with no separate enable.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-025",
      "revision": 0,
      "state": "D",
      "body": "Conflict pairs MUST be evaluated on the state that results from every change, including a new resource and a pair that enters force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-026",
      "revision": 0,
      "state": "D",
      "body": "A missing, ambiguous or cyclic parent link met while evaluating a conflict pair MUST reject the change with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-027",
      "revision": 0,
      "state": "D",
      "body": "An entry that names a deleted resource MUST be evaluated against conflict pairs with the last type and parent of that resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    }
  ],
