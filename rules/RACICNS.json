{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACICNS",
    "title": "RACI constraints",
    "description": "The named constraints that express strictness, and how a violating change is handled (SPEC.md section 2)."
  },
  "rule_set": {
    "version": "0.1.94",
    "timestamp": "2026-11-27T15:25:25Z",
    "hash": "blake3:88b36e82b3d800630775f3b09adc1ef6b607f4d823c19d2be384ab82897d9cd3"
  },
  "rules": [
    {
      "id": "RACICNS-001",
      "revision": 0,
      "state": "D",
      "body": "Strictness MUST be expressed as a set of named constraints, each switchable per realm: single-accountable, single-responsible, one-role-per-party, min-ra and separation-of-duties.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-002",
      "revision": 0,
      "state": "D",
      "body": "When single-accountable is enabled, there MUST be at most one A per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-003",
      "revision": 0,
      "state": "D",
      "body": "When single-responsible is enabled, there MUST be at most one R per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-004",
      "revision": 0,
      "state": "D",
      "body": "When one-role-per-party is enabled, a party MUST hold at most one role per activity and resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-005",
      "revision": 3,
      "state": "D",
      "body": "When min-ra is enabled, at least one R or A recorded by the realm that owns a resource MUST remain per activity on that resource, except on a resource that the change deletes, so removing the last one otherwise needs a named substitute.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-006",
      "revision": 2,
      "state": "D",
      "body": "When a conflict pair is in effect, a party that holds any role of one side MUST NOT hold another grant with any role of the other side on resources that stand in the relation of the pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-007",
      "revision": 1,
      "state": "D",
      "body": "A change that violates an enabled constraint MUST be rejected, with no silent demotion or alteration of roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-008",
      "revision": 1,
      "state": "D",
      "body": "Constraint evaluation MUST be deterministic and performed by the raci CLI.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-009",
      "revision": 4,
      "state": "D",
      "body": "A change MUST also revalidate, read-only, every ancestor or descendant realm whose constraints count a grant that the change records, and every descendant realm that a resource, pair or constraint of the change reaches.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-010",
      "revision": 1,
      "state": "D",
      "body": "Realms outside the realm tree of a change MUST NOT be revalidated by it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-011",
      "revision": 1,
      "state": "D",
      "body": "A conflict pair MUST be evaluated between every two grants recorded by the declaring realm, its ancestors or its descendants, sibling realms included, and between no others.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-012",
      "revision": 0,
      "state": "D",
      "body": "An explicit, logged replace action MAY transfer a role within one audited change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-013",
      "revision": 0,
      "state": "D",
      "body": "An LLM-based review of a change MUST be advisory only.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-014",
      "revision": 2,
      "state": "D",
      "body": "A change MUST be rejected, naming the realm and the constraint, if it violates a constraint of an ancestor or descendant realm that it revalidates.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-015",
      "revision": 0,
      "state": "D",
      "body": "Violations in realms outside the realm tree of a change MUST be reported as findings when those realms next load.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACICNS-016",
      "revision": 0,
      "state": "D",
      "body": "A conflict pair MUST have a relation of same, lineage or any and two sides, each with an activity, a resource selector and a set of roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-017",
      "revision": 0,
      "state": "D",
      "body": "A side of a conflict pair MUST match a grant of an activity, resource and role when the activity and resource are selected and the role is any one of its roles.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-018",
      "revision": 0,
      "state": "D",
      "body": "The relation same MUST hold only for one and the same resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-019",
      "revision": 0,
      "state": "D",
      "body": "The relation lineage MUST hold only for one and the same resource or for two resources of which one is an ancestor of the other through parent links.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-020",
      "revision": 0,
      "state": "D",
      "body": "The relation any MUST hold for any two resources in the scope of the pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-021",
      "revision": 0,
      "state": "D",
      "body": "A single grant MUST NOT conflict with itself.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-022",
      "revision": 0,
      "state": "D",
      "body": "The two sides of a conflict pair MUST be evaluated as unordered, so that a pair and its mirror are the same pair.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-023",
      "revision": 0,
      "state": "D",
      "body": "The effective conflict pairs of a realm MUST be those of the applied add-pair events and of the conflict-pair rules in force in that realm and its ancestors.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-024",
      "revision": 0,
      "state": "D",
      "body": "Separation of duties MUST be in effect whenever the effective conflict pairs are not empty, with no separate enable.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-025",
      "revision": 0,
      "state": "D",
      "body": "Conflict pairs MUST be evaluated on the state that results from every change, including a new resource and a pair that enters force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-026",
      "revision": 0,
      "state": "D",
      "body": "A missing or cyclic parent link met while evaluating a conflict pair MUST fail the evaluation closed, and never read as unrelated resources.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-027",
      "revision": 0,
      "state": "D",
      "body": "An entry that references a resource that is not live MUST fail the evaluation of conflict pairs closed.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-028",
      "revision": 0,
      "state": "D",
      "body": "The exemption of a delete from min-ra MUST cover only the resource that the change deletes, and no other entry that the same change removes.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-029",
      "revision": 0,
      "state": "D",
      "body": "The delete and its removals MUST NOT record a result for min-ra.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACICNS-030",
      "revision": 0,
      "state": "D",
      "body": "A grant MUST NOT be hidden from a conflict pair by a grant of another realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-031",
      "revision": 0,
      "state": "D",
      "body": "The same grant recorded by several realms MUST count as one grant.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-032",
      "revision": 0,
      "state": "D",
      "body": "The single-accountable, single-responsible and one-role-per-party constraints MUST count together the grants recorded by the realm that enables them, its ancestors and all its descendants, sibling realms included.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-033",
      "revision": 0,
      "state": "D",
      "body": "A change MUST read, without writing, every log whose grants a constraint that the change evaluates or revalidates counts, and fail if one of those logs cannot be replayed.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-034",
      "revision": 0,
      "state": "D",
      "body": "A conflict pair that names a resource MUST be rejected with invalid-change unless that resource is live in the declaring realm, an ancestor or a descendant when the pair is declared.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-035",
      "revision": 0,
      "state": "D",
      "body": "A conflict pair with the relation same that names two different resources MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-036",
      "revision": 0,
      "state": "D",
      "body": "The min-ra constraint MUST apply to a resource only when it is in the effective policy of the realm that owns that resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-25",
      "supersedes": null
    },
    {
      "id": "RACICNS-037",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be taken to violate a constraint only when the violation involves an event of the change: a grant or a removal that it records, or a constraint or conflict pair that it brings into force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-27",
      "supersedes": null
    },
    {
      "id": "RACICNS-038",
      "revision": 0,
      "state": "D",
      "body": "A violation that does not involve an event of the change MUST NOT reject it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-27",
      "supersedes": null
    }
  ],
