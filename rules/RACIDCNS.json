      "id": "RACIDCNS-001",
      "revision": 0,
      "state": "D",
      "body": "The strict preset MUST enable the constraints single-accountable, single-responsible, one-role-per-party and min-ra.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACIDCNS-002",
      "revision": 1,
      "state": "D",
      "body": "The constraint separation-of-duties MUST be opt-in, enabled only together with a list of conflict pairs and excluded from the strict preset.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    }
  ],
  "notes": [
