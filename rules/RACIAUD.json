{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIAUD",
    "title": "RACI audit log",
    "description": "The append-only audit log: event shape, change transactions, hash chain and offline storage (SPEC.md section 4)."
  },
  "rule_set": {
    "version": "0.1.200",
    "timestamp": "2026-11-22T14:57:37Z",
    "hash": "blake3:c5ec470a63b1ea4d0d5d594d22d9705f9ce39ac39ec2d75483e453755e4c0e01"
  },
  "rules": [
    {
      "id": "RACIAUD-001",
      "revision": 0,
      "state": "D",
      "body": "Every change to RACI state MUST be recorded as an append-only event in the audit log of the realm where the change lands.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-002",
      "revision": 0,
      "state": "D",
      "body": "The audit log MUST be the source of truth for the RACI state of a realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-003",
      "revision": 0,
      "state": "D",
      "body": "Policy and rule changes MUST be audited as events of their own types, separate from entry and resource events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-004",
      "revision": 1,
      "state": "D",
      "body": "An audit event MUST have the type entry, resource, constraint, rule, pin, revert or commit.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-005",
      "revision": 0,
      "state": "D",
      "body": "Every audit event MUST carry an id, a per-realm sequence number, a timestamp, the realm, the type, a change id, an actor, an outcome and its hashes.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-006",
      "revision": 0,
      "state": "D",
      "body": "The actor of an event MUST record the party and whether the change arrived as user, agent, import or inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-007",
      "revision": 0,
      "state": "D",
      "body": "An inferred event MUST record as its cause the id of its inference rule and of the originating event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-008",
      "revision": 0,
      "state": "D",
      "body": "An inferred event MUST NOT be the cause of another event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-009",
      "revision": 0,
      "state": "D",
      "body": "Every event MUST record each enabled constraint that was evaluated, with its result.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-010",
      "revision": 0,
      "state": "D",
      "body": "A rejected change MUST be logged with outcome rejected, and not only an applied one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-011",
      "revision": 0,
      "state": "D",
      "body": "A change and everything inferred from it MUST share one change id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-012",
      "revision": 0,
      "state": "D",
      "body": "A change and everything inferred from it MUST be written to the log of the realm where the original change lands.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-013",
      "revision": 0,
      "state": "D",
      "body": "A change id, its commit marker and the hash chain MUST NOT span two realms.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-014",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be all or nothing.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-015",
      "revision": 0,
      "state": "D",
      "body": "A violation of an enabled constraint by the original change or by any inferred change MUST reject the whole change id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-016",
      "revision": 0,
      "state": "D",
      "body": "A rejection MUST be logged with the violating event and the violated constraint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-017",
      "revision": 1,
      "state": "D",
      "body": "The last event of a change MUST be its commit marker, listing the ids of the other events of the change in log order, with the outcome of the change in its envelope.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-018",
      "revision": 0,
      "state": "D",
      "body": "Replay MUST apply a change only if its commit marker is present and has outcome applied.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-019",
      "revision": 0,
      "state": "D",
      "body": "Replay MUST ignore the events of a change that has no commit marker or a rejected one, while they stay in the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-020",
      "revision": 1,
      "state": "D",
      "body": "The CLI MUST report as incomplete the events of a change that has neither a commit marker nor an applied revert that abandons it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-021",
      "revision": 0,
      "state": "D",
      "body": "A commit marker MAY list non-blocking findings, each with a code and a detail.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-022",
      "revision": 0,
      "state": "D",
      "body": "An entry event MUST record an operation of add, update, remove or replace, the target and the role sets before and after.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-023",
      "revision": 0,
      "state": "D",
      "body": "A remove event MUST have an empty after role set.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-024",
      "revision": 0,
      "state": "D",
      "body": "A replace MUST be recorded as two linked entry events sharing one change id, one losing the role and one gaining it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-025",
      "revision": 1,
      "state": "D",
      "body": "An entry event resolved by stricter-wins MUST record as its conflict the rule id of the kept delta and the rule id of the dropped one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-026",
      "revision": 1,
      "state": "D",
      "body": "A resource event MUST record the operation new or delete and the id, type and optional parent of the resource, the realm of the resource being the realm of the event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-027",
      "revision": 0,
      "state": "D",
      "body": "A constraint event MUST be limited to the operations enable and add-pair, so that a constraint is never disabled or removed.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-028",
      "revision": 0,
      "state": "D",
      "body": "A rule event MUST carry the full structured body of the rule and its body hash.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-029",
      "revision": 0,
      "state": "D",
      "body": "The body hash of a rule event MUST be blake3 over the canonical JSON of the body alone.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-030",
      "revision": 1,
      "state": "D",
      "body": "A rule event MUST carry the lifecycle transition that it records, if it records one, and the id of the rule that it supersedes, if it supersedes one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-031",
      "revision": 0,
      "state": "D",
      "body": "A pin event MUST name the dependency realm and the pinned version, kept apart from the realm that owns the event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-032",
      "revision": 0,
      "state": "D",
      "body": "A later pin event for the same dependency realm MUST replace the earlier one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-033",
      "revision": 0,
      "state": "D",
      "body": "The hash of an event MUST be blake3 over the canonical JSON of the event without its hash and with its prev_hash included.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-034",
      "revision": 0,
      "state": "D",
      "body": "Canonical JSON MUST follow RFC 8785 throughout.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-035",
      "revision": 0,
      "state": "D",
      "body": "Every digest MUST be the string blake3 followed by a colon and 64 lowercase hexadecimal characters.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-036",
      "revision": 0,
      "state": "D",
      "body": "The first event of a realm MUST have the all-zero digest as its prev_hash.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-037",
      "revision": 0,
      "state": "D",
      "body": "Every later event MUST carry the hash of the previous event of the realm as its prev_hash.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-038",
      "revision": 1,
      "state": "D",
      "body": "Verification MUST recompute every hash, check every prev_hash link and check that seq runs from 1 without gap or repeat, failing at the first mismatch.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-039",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST check the body hash of each rule event against its body.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-040",
      "revision": 0,
      "state": "D",
      "body": "An offline log MUST be one JSONL file per realm, next to the .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-041",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST be the only writer of an offline log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-042",
      "revision": 0,
      "state": "D",
      "body": "Offline mode MUST be single-writer per realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-043",
      "revision": 0,
      "state": "D",
      "body": "Materialisation MUST treat a removed entry as absent from the point of removal onward.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-044",
      "revision": 0,
      "state": "D",
      "body": "For a rendered rule, verification MUST also check the body hash against the rendered SteerSpec rule and the authoring source.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIAUD-045",
      "revision": 0,
      "state": "D",
      "body": "Every audit event MUST carry its type-specific members in a payload object and never beside the envelope members.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-046",
      "revision": 0,
      "state": "D",
      "body": "The id and the change id of an event MUST be UUIDv7 strings in lowercase canonical text form.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-047",
      "revision": 0,
      "state": "D",
      "body": "The first event of a realm MUST have seq 1 and every later event the seq of the previous event plus one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-048",
      "revision": 0,
      "state": "D",
      "body": "The timestamp of an event MUST be RFC 3339 in UTC with millisecond precision and the Z suffix.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-049",
      "revision": 0,
      "state": "D",
      "body": "The order of the events of a realm MUST be given by seq and never by timestamp.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-050",
      "revision": 0,
      "state": "D",
      "body": "An event MUST carry a cause exactly when its actor arrived via inference.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-051",
      "revision": 0,
      "state": "D",
      "body": "The constraints of an event MUST be an object that maps the name of each evaluated constraint to the result pass or fail.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-052",
      "revision": 0,
      "state": "D",
      "body": "A rejected outcome MUST carry a reason of constraint-violation, no-rules-in-force, invalid-change or change-rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-053",
      "revision": 0,
      "state": "D",
      "body": "In a rejected change every event that caused no rejection itself MUST carry the reason change-rejected.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-054",
      "revision": 0,
      "state": "D",
      "body": "The role sets before and after of an entry event MUST be strings of the held roles in the fixed order A, R, C, I, the empty string holding none.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-055",
      "revision": 0,
      "state": "D",
      "body": "A constraint event MUST carry one conflict pair as params exactly when its operation is add-pair, which is valid only for separation-of-duties.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-056",
      "revision": 0,
      "state": "D",
      "body": "A rule event MUST record the lifecycle state of the rule as of the event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-057",
      "revision": 0,
      "state": "D",
      "body": "The version of a pin event MUST be a semantic version of the form MAJOR.MINOR.PATCH.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-058",
      "revision": 0,
      "state": "D",
      "body": "The offline log of a realm MUST be named after its .raci file with .jsonl appended.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-059",
      "revision": 0,
      "state": "D",
      "body": "Every line of an offline log MUST be one event in canonical JSON terminated by a line feed, in UTF-8 without a byte order mark and with no blank line.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-060",
      "revision": 0,
      "state": "D",
      "body": "A torn last line of an offline log MUST NOT be applied.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-061",
      "revision": 0,
      "state": "D",
      "body": "Every audit event of format version 1 MUST be valid against schemas/raci-event-1.schema.json.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-062",
      "revision": 0,
      "state": "D",
      "body": "The constraints member of an event MUST be present even when it is empty.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-063",
      "revision": 0,
      "state": "D",
      "body": "An applied outcome MUST NOT carry a reason or a detail.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-064",
      "revision": 0,
      "state": "D",
      "body": "A torn last line MUST be reported as torn-line, whether or not it parses as an event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-065",
      "revision": 0,
      "state": "D",
      "body": "The commit marker of a rejected change MUST carry the reason and detail of the first event in log order that caused the rejection.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-066",
      "revision": 0,
      "state": "D",
      "body": "The to state of the transition of a rule event MUST equal its recorded state.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIAUD-067",
      "revision": 0,
      "state": "D",
      "body": "Every audit event MUST carry its format version in the raci member, the string 1 for this format.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-068",
      "revision": 0,
      "state": "D",
      "body": "After event format version 1 is frozen, a change to the set of valid events MUST be a new event format version.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-069",
      "revision": 0,
      "state": "D",
      "body": "Every event format version MUST keep the raci, seq, prev_hash and hash members, the definition of the hash and the line format of the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-070",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST read the format version of an event before validating the event against a schema.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-071",
      "revision": 0,
      "state": "D",
      "body": "A log line whose raci member is not a string holding a positive decimal integer without leading zeros MUST be treated as not being an event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-072",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST check the hash, prev_hash and seq of events whose format version it does not support.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-073",
      "revision": 0,
      "state": "D",
      "body": "A log that holds an event of an unsupported format version MUST NOT be replayed.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-074",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST NOT append to a log that holds an event of an unsupported format version, or rebuild its view.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-075",
      "revision": 0,
      "state": "D",
      "body": "A rule event MUST carry the payload format of its body, which is raci/1 in event format version 1.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-076",
      "revision": 0,
      "state": "D",
      "body": "A pin event MUST carry the digest of the content that the pinned version resolved to.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-077",
      "revision": 0,
      "state": "D",
      "body": "A log with an unsupported-version, hash-mismatch, seq-mismatch, torn-line, incomplete-change, view-ahead, pin-mismatch or pin-downgrade finding MUST be treated as not replayable.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-078",
      "revision": 0,
      "state": "D",
      "body": "A command that evaluates a change or answers from RACI state MUST fail without writing when any log it depends on is not replayable.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-079",
      "revision": 0,
      "state": "D",
      "body": "The view of a log that is not replayable MUST NOT be used as an input in place of that log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-080",
      "revision": 0,
      "state": "D",
      "body": "The events of a change MUST be consecutive in the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-081",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST NOT append to a log that is not replayable or rebuild its view, except by a revert of raci doctor.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-082",
      "revision": 0,
      "state": "D",
      "body": "raci doctor MUST NOT write anything unless a revert is explicitly requested.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-083",
      "revision": 0,
      "state": "D",
      "body": "A revert MUST NOT be started by any other command or run automatically.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-084",
      "revision": 0,
      "state": "D",
      "body": "A revert MUST be refused unless the only damage to the log is a torn last line, an unfinished last change or both.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-085",
      "revision": 0,
      "state": "D",
      "body": "A revert MUST remove no bytes other than those of a torn last line.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-086",
      "revision": 0,
      "state": "D",
      "body": "A revert that removes bytes MUST record them in base64 in its revert event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-087",
      "revision": 0,
      "state": "D",
      "body": "A revert event MUST form a change of its own with its commit marker, with an actor that arrived as user or agent.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-088",
      "revision": 0,
      "state": "D",
      "body": "A revert MUST replace the log file atomically, so that a crash leaves either the damaged log or the reverted one.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-089",
      "revision": 0,
      "state": "D",
      "body": "A revert event that abandons anything other than the unfinished change immediately before it MUST be treated as not being a valid event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-090",
      "revision": 0,
      "state": "D",
      "body": "Replay MUST NOT apply any event of an abandoned change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-091",
      "revision": 0,
      "state": "D",
      "body": "An event with an applied outcome MUST NOT record a failed constraint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIAUD-092",
      "revision": 0,
      "state": "D",
      "body": "A revert that abandons an unfinished change MUST record the id of that change in its revert event.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    }
  ],
