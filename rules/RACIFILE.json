{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIFILE",
    "title": "RACI file and verification",
    "description": "The .raci materialised view and the raci verify report (SPEC.md sections 7 and 7.1)."
  },
  "rule_set": {
    "version": "0.1.68",
    "timestamp": "2026-11-07T16:06:10Z",
    "hash": "blake3:bb1eda53df518a84b44d27f28704d7c303d47ab8343a907e8173256195e37df2"
  },
  "rules": [
    {
      "id": "RACIFILE-001",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST be a materialised view of the audit log of exactly one realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-002",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST hold RACI state and nothing else.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-003",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST NOT contain findings or history.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-004",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST be the only writer of a .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-005",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST be one canonical JSON document as defined by RFC 8785.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-006",
      "revision": 0,
      "state": "D",
      "body": "The same log MUST always yield a byte-identical .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-007",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST hold only the own state of its realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-008",
      "revision": 0,
      "state": "D",
      "body": "The entries and resources of ancestor and descendant realms MUST NOT be embedded in the .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-009",
      "revision": 0,
      "state": "D",
      "body": "The only data about other realms in the file MUST be pins and rules in force, derived from the own log of the realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-010",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST NOT carry filesystem paths.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-011",
      "revision": 0,
      "state": "D",
      "body": "The log of a realm MUST be found by convention, next to its .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-012",
      "revision": 0,
      "state": "D",
      "body": "The .raci file MUST have the members constraints, entries, log, pins, raci, realm, resources and rules_in_force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-013",
      "revision": 0,
      "state": "D",
      "body": "The raci member MUST be the format version string 1.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-014",
      "revision": 0,
      "state": "D",
      "body": "The log member MUST hold the head_seq and head_hash of the log state that the view reflects.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-015",
      "revision": 0,
      "state": "D",
      "body": "A view whose log head differs from the head of the log MUST be treated as stale and rebuilt by replay.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-016",
      "revision": 0,
      "state": "D",
      "body": "For an empty log the head MUST be head_seq 0 and the all-zero digest as head_hash.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-017",
      "revision": 0,
      "state": "D",
      "body": "The roles of an entry MUST be a string of the held roles in the fixed order A, R, C, I.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-018",
      "revision": 0,
      "state": "D",
      "body": "An entry with no roles MUST be absent from the file, not stored empty.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-019",
      "revision": 0,
      "state": "D",
      "body": "The arrays of the file MUST be in canonical order, resources by id, entries by resource, activity and party, rules in force by rule id, pins by dependency realm and version, enabled constraints alphabetically and pairs by their canonical JSON.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-020",
      "revision": 0,
      "state": "D",
      "body": "The rules in force MUST list every rule recorded in force in the log of the realm, inherited ones included, each with its body hash.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-021",
      "revision": 0,
      "state": "D",
      "body": "The pins MUST be derived from the pin events of the log and hold the current version of each dependency realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-022",
      "revision": 0,
      "state": "D",
      "body": "The constraints member MUST list only the constraints recorded by the own constraint events of the realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-023",
      "revision": 0,
      "state": "D",
      "body": "The effective constraint set along the realm path MUST be computed at load time and not embedded.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-024",
      "revision": 0,
      "state": "D",
      "body": "Verification findings MUST be emitted by raci verify as a separate report and not persisted in the .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-025",
      "revision": 0,
      "state": "D",
      "body": "A verification report MUST hold the realm, the log head and a list of findings, each with a code, a severity, a realm and a detail.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-026",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report a hash-mismatch finding of severity error when a recomputed hash or a prev_hash link fails.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-027",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report a view-mismatch finding of severity error when replay gives a different state than the .raci file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-028",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report a stale-view finding of severity warning when the log head of the view differs from the head of the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-029",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report an unrecorded-rule finding of severity error for a structured rule source that differs from the latest rule event for the same rule id in the log, or for which the log has no rule event for that rule id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-030",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report an incomplete-change finding of severity warning when a change id has events but no commit marker.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-031",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report a no-matching-rule finding of severity warning when a target was created with an empty RACI because no inference rule matched.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-032",
      "revision": 0,
      "state": "D",
      "body": "Verification MUST report a descendant-violation finding of severity error when a dependent realm outside the tree of the change violates a constraint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-033",
      "revision": 0,
      "state": "D",
      "body": "A verification report MUST include the findings recorded in commit markers, with severity and realm added.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIFILE-034",
      "revision": 0,
      "state": "D",
      "body": "A .raci file MUST NOT be hand-edited.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    }
  ],
