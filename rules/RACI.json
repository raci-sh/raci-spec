{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACI",
    "title": "RACI core model",
    "description": "The RACI.sh data model: realms, parties, roles, activities, resources and entries (SPEC.md section 1)."
  },
  "rule_set": {
    "version": "0.1.47",
    "timestamp": "2026-11-22T15:10:38Z",
    "hash": "blake3:de16cb854f69d70e7e923f425eb9eda2a6f0949e926e6b71dfb67fde283040d1"
  },
  "rules": [
    {
      "id": "RACI-001",
      "revision": 1,
      "state": "D",
      "body": "A RACI.sh realm MUST correspond to a SteerSpec realm, including its nesting into sub-realms.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-002",
      "revision": 0,
      "state": "D",
      "body": "A RACI entry MUST bind a party, human or agent, to a set of roles drawn from R, A, C and I, for an activity on a resource within a realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-003",
      "revision": 1,
      "state": "D",
      "body": "The RACI data model MUST be permissive, with strictness expressed as validation constraints and never as schema.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-004",
      "revision": 1,
      "state": "D",
      "body": "A resource MUST have a type and a realm, with an optional parent resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-005",
      "revision": 0,
      "state": "D",
      "body": "Role precedence for display and for the best role of a party MUST be A, then R, then C, then I.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-006",
      "revision": 1,
      "state": "D",
      "body": "An entry MUST NOT be erased: a removal is an event and the full history stays in the audit log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-007",
      "revision": 0,
      "state": "D",
      "body": "The creation and deletion of a resource MUST be audited events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-008",
      "revision": 0,
      "state": "D",
      "body": "A realm id MUST be a SteerSpec realm id: one or more dot-separated labels, each a lowercase letter followed by lowercase letters and digits.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-009",
      "revision": 0,
      "state": "D",
      "body": "An activity and a resource type MUST be lowercase kebab-case words.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-010",
      "revision": 0,
      "state": "D",
      "body": "A party id and a resource id MUST be strings of 1 to 256 Unicode code points with no control character.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-011",
      "revision": 0,
      "state": "D",
      "body": "Party ids and resource ids MUST be compared as exact strings, with no case folding or normalisation.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-012",
      "revision": 0,
      "state": "D",
      "body": "A resource MUST be identified by its realm and its id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-013",
      "revision": 0,
      "state": "D",
      "body": "A change that creates a resource with an id that an applied creation in the log of the same realm already used MUST be rejected with invalid-change, so an id is never reused.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-014",
      "revision": 0,
      "state": "D",
      "body": "Every reference to a resource MUST carry both its realm and its id, and resolve to that resource alone, never by a search for the id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-015",
      "revision": 0,
      "state": "D",
      "body": "A change that creates a resource whose parent is not a live resource of its realm or an ancestor MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-016",
      "revision": 0,
      "state": "D",
      "body": "A change that deletes a resource named as parent in its realm or a descendant MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-017",
      "revision": 0,
      "state": "D",
      "body": "The declaration of a resource MUST give its bare id, its realm being the realm of the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-018",
      "revision": 0,
      "state": "D",
      "body": "A change with an entry on a resource that is not a live resource of the realm of the log or an ancestor MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-019",
      "revision": 0,
      "state": "D",
      "body": "A change that deletes anything other than a live resource of the realm of the log, with its declared type and parent, MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-020",
      "revision": 0,
      "state": "D",
      "body": "A change that deletes a resource on which a descendant realm holds an entry MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-021",
      "revision": 0,
      "state": "D",
      "body": "An applied delete MUST remove every entry of its realm on the deleted resource in the same change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    }
  ],
