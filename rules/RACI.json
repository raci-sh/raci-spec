{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACI",
    "title": "RACI core model",
    "description": "The RACI.sh data model: realms, parties, roles, activities, resources and entries (SPEC.md section 1)."
  },
  "rule_set": {
    "version": "0.1.37",
    "timestamp": "2026-11-22T14:57:37Z",
    "hash": "blake3:f7af07051cbfedbf92ac603c09dfc51d2049408d44c46d40168a7075959530d3"
  },
  "rules": [
    {
      "id": "RACI-001",
      "revision": 1,
      "state": "D",
      "body": "A RACI.sh realm MUST correspond to a SteerSpec realm, including its nesting into sub-realms.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-002",
      "revision": 0,
      "state": "D",
      "body": "A RACI entry MUST bind a party, human or agent, to a set of roles drawn from R, A, C and I, for an activity on a resource within a realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-003",
      "revision": 1,
      "state": "D",
      "body": "The RACI data model MUST be permissive, with strictness expressed as validation constraints and never as schema.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-004",
      "revision": 1,
      "state": "D",
      "body": "A resource MUST have a type and a realm, with an optional parent resource.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-005",
      "revision": 0,
      "state": "D",
      "body": "Role precedence for display and for the best role of a party MUST be A, then R, then C, then I.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-006",
      "revision": 1,
      "state": "D",
      "body": "An entry MUST NOT be erased: a removal is an event and the full history stays in the audit log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-007",
      "revision": 0,
      "state": "D",
      "body": "The creation and deletion of a resource MUST be audited events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-06",
      "supersedes": null
    },
    {
      "id": "RACI-008",
      "revision": 0,
      "state": "D",
      "body": "A realm id MUST be a SteerSpec realm id: one or more dot-separated labels, each a lowercase letter followed by lowercase letters and digits.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-009",
      "revision": 0,
      "state": "D",
      "body": "An activity and a resource type MUST be lowercase kebab-case words.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-010",
      "revision": 0,
      "state": "D",
      "body": "A party id and a resource id MUST be strings of 1 to 256 Unicode code points with no control character.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-011",
      "revision": 0,
      "state": "D",
      "body": "Party ids and resource ids MUST be compared as exact strings, with no case folding or normalisation.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACI-012",
      "revision": 0,
      "state": "D",
      "body": "A resource MUST be identified by its realm and its id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-013",
      "revision": 0,
      "state": "D",
      "body": "A change that creates a resource MUST be rejected with invalid-change if its id exists in the realm, an ancestor or a descendant, or is still named by an entry there.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-014",
      "revision": 0,
      "state": "D",
      "body": "An id that resolves to more than one resource on a realm path MUST reject the change that evaluates it with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-015",
      "revision": 0,
      "state": "D",
      "body": "A change that creates a resource whose parent does not exist in its realm or an ancestor MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACI-016",
      "revision": 0,
      "state": "D",
      "body": "A change that deletes a resource named as parent in its realm or a descendant MUST be rejected with invalid-change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    }
  ],
  "notes": [
