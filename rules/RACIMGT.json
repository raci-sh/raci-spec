{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIMGT",
    "title": "RACI rule management",
    "description": "Rules in force, bootstrap, rendering into SteerSpec and customer realms (SPEC.md section 6)."
  },
  "rule_set": {
    "version": "0.1.42",
    "timestamp": "2026-11-07T15:48:07Z",
    "hash": "blake3:cbf6b2ddda0f37fa6dc5261ad865dc734ccef652afdaacfd01879293eb39b0d2"
  },
  "rules": [
    {
      "id": "RACIMGT-001",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh rules MUST have a structured source that the raci CLI evaluates deterministically.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-002",
      "revision": 0,
      "state": "D",
      "body": "The structured source MUST be the authoring format of a RACI.sh rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-003",
      "revision": 0,
      "state": "D",
      "body": "The canonical record of which rule is in force MUST be the audit log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-004",
      "revision": 0,
      "state": "D",
      "body": "Loading a new or changed rule source MUST append a rule event carrying the full structured body.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-005",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST evaluate only rules that are recorded in the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-006",
      "revision": 0,
      "state": "D",
      "body": "A rule source that differs from the latest rule event of the log MUST be reported as unrecorded.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-007",
      "revision": 0,
      "state": "D",
      "body": "Until rules are recorded in the log, a change to an entry MUST be rejected with no-rules-in-force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-008",
      "revision": 0,
      "state": "D",
      "body": "An explicit init MUST append a pin event for each dependency realm, then rule events with actor import for the in-force rules of the pinned versions and of the own entities of the realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-009",
      "revision": 0,
      "state": "D",
      "body": "Every later change of a pinned version MUST append a pin event and the corresponding rule events.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-010",
      "revision": 0,
      "state": "D",
      "body": "Inherited rules MUST be recorded in the log of the realm that uses them.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-011",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh rules MUST follow the SteerSpec lifecycle.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-012",
      "revision": 0,
      "state": "D",
      "body": "The sh.raci realm MUST hold the specification as hand-authored normative prose rules.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-013",
      "revision": 0,
      "state": "D",
      "body": "Default configuration rules MUST be rendered into SteerSpec rules in the sh.raci realm, with prose bodies and notes carrying the structured form.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-014",
      "revision": 0,
      "state": "D",
      "body": "A rendered rule MUST NOT be hand-edited.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-015",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be rejected only by a deterministic check.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-016",
      "revision": 0,
      "state": "D",
      "body": "A customer realm MUST depend on sh.raci like any SteerSpec realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-017",
      "revision": 0,
      "state": "D",
      "body": "A customer realm MUST customise by authoring structured rules in its own realm, rendered like the defaults.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-018",
      "revision": 0,
      "state": "D",
      "body": "A customer rule MUST add a rule or override an inherited one, subject to the override lint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-019",
      "revision": 0,
      "state": "D",
      "body": "A published RACI.sh rule MUST NOT be edited.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-020",
      "revision": 0,
      "state": "D",
      "body": "The LLM path MUST only review a change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-021",
      "revision": 0,
      "state": "D",
      "body": "Only a rule with a structured source MUST be recorded as a rule event, so a prose-only normative rule is never evaluated by the CLI.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    }
  ],
  "notes": [
