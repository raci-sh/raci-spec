{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIMGT",
    "title": "RACI rule management",
    "description": "Rules in force, bootstrap, rendering into SteerSpec and customer realms (SPEC.md section 6)."
  },
  "rule_set": {
    "version": "0.1.76",
    "timestamp": "2026-11-22T09:36:32Z",
    "hash": "blake3:5fd3c306b0b80e1efc60b2f5eccd83f19d6ead44e1d30632f62427d80df7fee9"
  },
  "rules": [
    {
      "id": "RACIMGT-001",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh configuration rules, meaning constraints, inference rules and default rule-management rules, MUST have a structured source that the raci CLI evaluates deterministically.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-002",
      "revision": 0,
      "state": "D",
      "body": "The structured source MUST be the authoring format of a RACI.sh configuration rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-003",
      "revision": 0,
      "state": "D",
      "body": "The canonical record of which rule is in force MUST be the audit log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-004",
      "revision": 0,
      "state": "D",
      "body": "Loading a new or changed structured rule source MUST append a rule event carrying the full structured body.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-005",
      "revision": 0,
      "state": "D",
      "body": "The CLI MUST evaluate only rules that are recorded in the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-006",
      "revision": 0,
      "state": "D",
      "body": "A structured rule source MUST be reported as unrecorded when it differs from the latest rule event for the same rule id in the log, or when the log has no rule event for that rule id.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-007",
      "revision": 0,
      "state": "D",
      "body": "Until rules are recorded in the log, a change to an entry MUST be rejected with no-rules-in-force.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-008",
      "revision": 0,
      "state": "D",
      "body": "An explicit init MUST append a pin event for each dependency realm, then rule events with actor import for the in-force rules with a structured source of the pinned versions and of the own entities of the realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-009",
      "revision": 0,
      "state": "D",
      "body": "Every later change of a pinned version MUST append a pin event and the rule events of the rules with a structured source that the new version brings in.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-010",
      "revision": 0,
      "state": "D",
      "body": "Inherited rules with a structured source MUST be recorded in the log of the realm that uses them.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-011",
      "revision": 0,
      "state": "D",
      "body": "RACI.sh rules MUST follow the SteerSpec lifecycle.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-012",
      "revision": 0,
      "state": "D",
      "body": "The sh.raci realm MUST hold the specification as hand-authored normative prose rules.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-013",
      "revision": 0,
      "state": "D",
      "body": "Default configuration rules MUST be rendered into SteerSpec rules in the sh.raci realm, with prose bodies and notes carrying the structured form.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-014",
      "revision": 0,
      "state": "D",
      "body": "A rendered rule MUST NOT be hand-edited.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-015",
      "revision": 0,
      "state": "D",
      "body": "A change MUST be rejected only by a deterministic check.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-016",
      "revision": 0,
      "state": "D",
      "body": "A customer realm MUST depend on sh.raci like any SteerSpec realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-017",
      "revision": 0,
      "state": "D",
      "body": "A customer realm MUST customise by authoring structured rules in its own realm, rendered like the defaults.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-018",
      "revision": 0,
      "state": "D",
      "body": "A customer rule MUST add a rule or override an inherited one, subject to the override lint.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-019",
      "revision": 0,
      "state": "D",
      "body": "A published RACI.sh rule MUST NOT be edited.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-020",
      "revision": 0,
      "state": "D",
      "body": "The LLM path MUST only review a change.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-021",
      "revision": 0,
      "state": "D",
      "body": "Only a rule with a structured source MUST be recorded as a rule event, so a prose-only normative rule is never evaluated by the CLI.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "RACIMGT-022",
      "revision": 0,
      "state": "D",
      "body": "The version of a realm MUST be the realm.version of its realm.json, a semantic version of the form MAJOR.MINOR.PATCH.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-023",
      "revision": 0,
      "state": "D",
      "body": "Every release of the sh.raci realm after 1.0.0 MUST be tagged vX.Y.Z with X.Y.Z equal to its realm.version.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-024",
      "revision": 0,
      "state": "D",
      "body": "A change to the rules in force that can reject a change the previous version accepted MUST bump the MAJOR version, or the MINOR version before 1.0.0.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-025",
      "revision": 0,
      "state": "D",
      "body": "A realm MUST declare each dependency realm in the dependencies of its realm.json with a realm id, a version and a source.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-026",
      "revision": 0,
      "state": "D",
      "body": "raci init and every later change of a declared version MUST fetch each dependency realm from its declared source at its declared version.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-027",
      "revision": 0,
      "state": "D",
      "body": "The raci CLI MUST NOT embed a copy of a dependency realm.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-028",
      "revision": 0,
      "state": "D",
      "body": "A command that cannot fetch a dependency realm, or fetches one whose id or version differs from the declared one, MUST fail without writing to the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-029",
      "revision": 0,
      "state": "D",
      "body": "The version of a pin event MUST be the declared version string of the dependency realm, exactly.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-030",
      "revision": 0,
      "state": "D",
      "body": "The pin events and rule events appended by an init or a version change MUST form one change with one change id and one commit marker.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-031",
      "revision": 0,
      "state": "D",
      "body": "A rule event appended by an init or a version change MUST record the state of the rule in the fetched realm without a transition.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-032",
      "revision": 0,
      "state": "D",
      "body": "An init or a version change MUST record rule events only for fetched rules in state P or I.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-21",
      "supersedes": null
    },
    {
      "id": "RACIMGT-033",
      "revision": 0,
      "state": "D",
      "body": "A dependency on sh.raci whose source tag is not v followed by its declared version MUST be refused without writing to the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIMGT-034",
      "revision": 0,
      "state": "D",
      "body": "Version 1.0.0 of sh.raci MUST NOT be pinned, since the realm.version at its tag is 0.1.0.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIMGT-035",
      "revision": 0,
      "state": "D",
      "body": "The digest of a fetched realm MUST be blake3 over the canonical JSON of an object that maps the relative path of each of its JSON files to the blake3 of the canonical JSON of that file.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIMGT-036",
      "revision": 0,
      "state": "D",
      "body": "A fetched realm that holds a symbolic link or a JSON file that is not I-JSON MUST be refused.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIMGT-037",
      "revision": 0,
      "state": "D",
      "body": "The first pin of a version of a dependency realm in a log MUST be made from a fetch of its source and never from a cached copy.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    },
    {
      "id": "RACIMGT-038",
      "revision": 0,
      "state": "D",
      "body": "Content whose digest differs from that of an applied pin of the same realm and version in the log MUST be refused without writing to the log.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-22",
      "supersedes": null
    }
  ],
