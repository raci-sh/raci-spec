{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "RACIDMGT",
    "title": "RACI default rule-management rules",
    "description": "Default rule-management activities on SteerSpec rules: author, update, publish, retire and override (SPEC.md sections 3.2 and 6)."
  },
  "rule_set": {
    "version": "0.1.0",
    "timestamp": "2026-11-08T21:32:24Z",
    "hash": "blake3:04622b4307b214f6d2932df7b527bdc30518242a8b3b77af840cbce8561b5277"
  },
  "rules": [
    {
      "id": "RACIDMGT-001",
      "revision": 0,
      "state": "D",
      "body": "The rule-management activities MUST be author, update, publish, retire and override.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-002",
      "revision": 0,
      "state": "D",
      "body": "The author activity MUST cover creating a rule in state D.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-003",
      "revision": 0,
      "state": "D",
      "body": "The update activity MUST cover changing a rule in state D and adding or changing a note on a rule in any state.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-004",
      "revision": 0,
      "state": "D",
      "body": "The publish activity MUST cover the transition of a rule into state P.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-005",
      "revision": 0,
      "state": "D",
      "body": "The retire activity MUST cover the transition of a rule out of state P or I.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-006",
      "revision": 0,
      "state": "D",
      "body": "The override activity MUST cover authoring a rule that overrides an inherited rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    },
    {
      "id": "RACIDMGT-007",
      "revision": 0,
      "state": "D",
      "body": "Rule-management RACI MUST be held on a resource of type rule.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-08",
      "supersedes": null
    }
  ],
